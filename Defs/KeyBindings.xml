    <category>PickMeUp_Category</category>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>PickMeUp_ToggleMarkers</defName>
    <label>Show/hide arrow markers</label>
    <category>PickMeUp_Category</category>
  </KeyBindingDef>

</Defs>
